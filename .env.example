APP_NAME="BizBot"
APP_ENV="dev"
APP_HOST="0.0.0.0"
APP_PORT="80"

PREMIUM_API_KEY="change-me-very-secret"

PUBLIC_RATE_LIMIT_PER_MIN="60"
PREMIUM_RATE_LIMIT_PER_MIN="300"

CACHE_BACKEND="memory"
CACHE_TTL_SECONDS="600"
CACHE_MAX_ITEMS="256"
REDIS_URL="redis://localhost:6379/0"

LLM_PROVIDER="OPENAI"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
HF_API_TOKEN=""
HF_MODEL="mistralai/Mistral-7B-Instruct-v0.3"

STRIPE_API_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
STRIPE_SUCCESS_URL="http://localhost:8080/static/success.html"
STRIPE_CANCEL_URL="http://localhost:8080/static/cancel.html"
STRIPE_PORTAL_RETURN_URL="http://localhost:8080/"

# Admin (token for /admin endpoints)
ADMIN_TOKEN="change-admin-token"
